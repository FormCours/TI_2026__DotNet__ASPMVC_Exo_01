@using System.Globalization
@model Travel
@{
    ViewData["Title"] = $"Détails de {Model.Title}" ;
    
}
<section>
    <div class="container py-lg-3 py-md-2 py-sm-2 py-1">
        <div class="row">
            <div class="col-12 text-right about-two-grids mb-3">
                <h3 class="title mb-md-4 mb-sm-3 mb-3">@Model.Title</h3>
                <div class="about-para-txt">
                <p>@Model.Desc</p>
                </div>
            </div>

            <div class="col-8 about-imgs-txt">
              <img src="@Model.Image" alt="@Model.ShortDesc" class="img-fluid">
            </div>

            <div class="col-lg-4 about-imgs-txt">
                <div class="row my-lg-3 my-md-2 my-1">
                    <div class="col-lg-3 col-md-3 col-sm-3 text-center">
                        <div class="about-span-txt">
                        <span class="fa fa-address-book" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="about-w3layouts-left col-lg-9 col-md-9 col-sm-9">
                        <h6 class="mb-lg-3 mb-2">Pays</h6>
                        <p>@Model.Pays</p>
                    </div>
                </div>
                <div class="row my-lg-3 my-md-2 my-1">
                    <div class="col-lg-3 col-md-3 col-sm-3 text-center">
                        <div class="about-span-txt">
                        <span class="fa fa-credit-card" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="about-w3layouts-left col-lg-9 col-md-9 col-sm-9">
                        <h6 class="mb-lg-3 mb-2">Prix</h6>
                        <p>
                            @Model.Price.ToString("C", CultureInfo.CreateSpecificCulture("fr-BE"))
                        </p>
                    </div>
                </div>
                <div class="row my-lg-3 my-md-2 my-1">
                    <div class="col-lg-3 col-md-3 col-sm-3 text-center">
                        <div class="about-span-txt">
                        <span class="fa fa-trophy" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="about-w3layouts-left col-lg-9 col-md-9 col-sm-9">
                        <h6 class="mb-lg-3 mb-2">Avis</h6>
                        <div>
                            @for (var i = 0; i < 10; i+=2)
                            {

                                if (Model.Rating -i >= 2 )
                                {
                                    <span class="fa fa-star" aria-hidden="true"></span>
                                }

                                else if (Model.Rating - i == 1)
                                {
                                    <span class="fa fa-star-half-o" aria-hidden="true"></span>
                                   
                                }
                                else
                                {
                                    <span class="fa fa-star-o" aria-hidden="true"></span>
                               
                                }

                            }
                         
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>