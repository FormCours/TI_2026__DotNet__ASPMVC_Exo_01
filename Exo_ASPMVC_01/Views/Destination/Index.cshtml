@model IEnumerable<Travel>
@{
    ViewData["Title"] = "Les destinations";
    int cpt = 1;
}
<section>

    @foreach (Travel travel in Model)
    {
        <div class="row @(cpt%2 == 1 ? "flex-row-reverse": "")">
            <div class="col-lg-5 blog-two-two">
                <h4 class="mb-3">
                    <a asp-controller="Destination" asp-action="Detail" asp-route-id="@travel.Id">@travel.Title</a>
                </h4>
                <p>@travel.ShortDesc</p>
                <div class="view-buttn mt-md-4 mt-sm-4 mt-3">
                    <a asp-controller="Destination" asp-action="Detail" asp-route-id="@travel.Id" class="btn">Plus d'info</a>
                </div>
            </div>
            <div class="col-lg-7">
                <img src="@travel.Thumbnail" alt="@travel.Title" class="img-fluid">
            </div>
        </div>
        cpt++;
    }
    
  </section>