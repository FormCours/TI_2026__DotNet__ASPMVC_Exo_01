<!DOCTYPE html>
<html lang="fr">
<head>
    <title>@ViewData["Title"] - Exo_ASPMVC_01</title>
    <!--meta tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--//meta tags ends here-->
    <!--booststrap-->
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" media="all">
    <!--//booststrap end-->
    <!-- font-awesome icons -->
    <link href="~/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <!-- //font-awesome icons -->
    <!--stylesheets-->
    <link href="~/css/style.css" rel='stylesheet' type='text/css' media="all">
    <!--//stylesheets-->
    <link href="//fonts.googleapis.com/css?family=Playfair+Display:400,700" rel="stylesheet">
    <link href="//fonts.googleapis.com/css?family=Open+Sans:400,600,700" rel="stylesheet">
    @await RenderSectionAsync("StylePerso", required: false)
    <script>
            addEventListener("load", function () {
                setTimeout(hideURLbar, 0);
            }, false);

            function hideURLbar() {
                window.scrollTo(0, 1);
            }
    </script>
</head>

<body class="min-vh-100 d-flex flex-column">
    <!--headder-->
    <partial name= "Partial/_Header" />
    <!-- //header -->
    <div class="flex-grow-1">
        @RenderBody()
    </div>
    <!-- footer -->
    <partial name="Partial/_Footer" />
    <!--//footer -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
