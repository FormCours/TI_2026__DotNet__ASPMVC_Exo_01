@model IEnumerable<Blog>
@{
    ViewData["Title"] = $"Liste de d'articles";
    int nbPage = (int)ViewData["Page"] ;
}
<section>
    <div class="container py-lg-3 py-md-2 py-sm-2 py-1">
        <div class="row">
            <div class="col-12 text-right about-two-grids mb-3">
                <h3 class="title mb-md-4 mb-sm-3 mb-3">
                    Blog !
                </h3>
            </div>

            @foreach (Blog b in Model)
            {
                
                <div class="col-12 mb-3">
                  <div class="about-w3layouts-left col-lg-9 col-md-9 col-sm-9" id="@b.Slug">
                        <h6 class="mb-lg-3 mb-2 row justify-content-between">
                            <span>@b.Title</span>
                            <span>@b.CreateDate.ToString("dd'/'MM'/'yyyy - HH'h'mm")</span>
                        </h6>
                        <p>@b.Content</p>
                    </div>
                  </div>
            }
                <div>
                @if (nbPage > 1)
                {
                    <a asp-controller="Blog" asp-action="Index" asp-route-page ="@(nbPage-1)" class="mr-2">Page précédente</a>
                }
                @if(Model.Count() == 5)
                {
                    <a asp-controller="Blog" asp-action="Index" asp-route-page ="@(nbPage+1)">Page suivante</a>
                }
                </div>
              </div>
            </div>
</section>