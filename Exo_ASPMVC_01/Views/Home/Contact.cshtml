@model ContactForm

<section>
    <div class="container py-lg-3 py-md-2 py-sm-2 py-1">
        <div class="row">
            <div class="col-12 text-right about-two-grids mb-3">
                <h3 class="title mb-md-4 mb-sm-3 mb-3">
                    Formulaire de contact
                </h3>
            </div>

            <div class="col-12 contact-form-txt">
                <form action="#" method="post">
                    <div class="form-group contact-forms">
                        <input asp-for="FirstName"  class="form-control" placeholder="Prénom" aria-label="Prenom">
                    </div>
                    <div class="form-group contact-forms">
                        <input asp-for="LastName" class="form-control" placeholder="Nom" aria-label="Nom">
                    </div>
                    <div class="form-group contact-forms">
                        <input asp-for="Email" class="form-control" placeholder="Couriel" aria-label="Couriel">
                    </div>
                    <div class="form-group contact-forms">
                        <input asp-for="Tel" class="form-control" placeholder="Tel" aria-label="Tel">
                    </div>
                    <div class="form-group contact-forms">
                        <textarea asp-for="Message" class="form-control" placeholder="Message" aria-label="Message" rows="5"></textarea>
                    </div>
                    <button type="submit" class="btn sent-butnn">Send</button>
                </form>
            </div>

        </div>
    </div>
</section>